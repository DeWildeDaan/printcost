# Copy to .env and fill in with your identity provider's details.
# The whole site is protected by OIDC/SSO login - all of these are required.

OIDC_ISSUER_URL=https://your-idp.example.com/
OIDC_CLIENT_ID=printcost
OIDC_CLIENT_SECRET=changeme
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
# Generate with: openssl rand -hex 32
SESSION_SECRET=changeme

# Optional, see README for defaults
# PORT=8080
# DB_PATH=./printcost.db
# BASE_URL_PREFIX=
